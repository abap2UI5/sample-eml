{
  "global": {
    "files": "/src/**/*.*",
    // z2ui5_cl_smps_evt_tck is a RAP business event handler. Its two
    // constructs - CLASS ... DEFINITION PUBLIC FOR EVENTS OF <entity> in the
    // global class and METHODS ... FOR ENTITY EVENT <evt> FOR <entity>~<evt>
    // in the handler pool - have no grammar in abaplint, so the class pool
    // does not parse. Every finding on the two ABAP files is a consequence
    // of that parse failure, not of the ABAP: the structure error, the
    // parser errors on the two METHODS statements, and the check_syntax
    // follow-ups on the handler methods and their event tables. The
    // structure error comes from the parser itself rather than from a rule,
    // so a per rule "exclude" cannot reach it and the whole file has to be
    // silenced. Scoped to the ABAP: the class .clas.xml is not listed, so
    // object_naming and xml_consistency still cover the object. Drop this
    // once abaplint parses the RAP event syntax.
    "noIssues": [
      "z2ui5_cl_smps_evt_tck\\.clas\\.abap$",
      "z2ui5_cl_smps_evt_tck\\.clas\\.locals_imp\\.abap$"
    ]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    // EML (READ/MODIFY/COMMIT ENTITIES) requires ABAP Platform >= 1909,
    // therefore this sample is not downported like the other repositories
    "version": "v757",
    // the RAP business object /DMO/I_TRAVEL_M of the SAP flight reference
    // scenario is not part of the dependencies, only Z2UI5* objects are
    // resolved strictly
    "errorNamespace": "^Z2UI5"
  },
  "rules": {
    "exporting": true,
    "omit_parameter_name": true,
    "line_length": {
      "length": 255
    },
    // Every object carries the stack sample token SMPS behind its type token,
    // the scheme the samples repository uses with its SMP token:
    //   Z2UI5_CL_SMPS_<object>   classes, including the behavior pools
    //   Z2UI5_T_SMPS_<object>    persistent tables
    //   Z2UI5_D_SMPS_<object>    draft tables
    // Class names are capped at 25 characters by the leading lookahead. ABAP
    // allows 30, but build_rename (see abap2UI5) replaces the namespace
    // z2ui5 (5 chars) with up to 9, which costs 4 - so 26 is the hard
    // ceiling and 25 keeps one character in reserve.
    // Tables are capped at 16: that is the hard DDIC limit for a transparent
    // table, not a convention. A 17 character table name does not activate.
    // The CDS root view entities and their behavior definitions follow the
    // same scheme with the type token R, but abaplint has no object_naming
    // key for DDLS or BDEF, so those two are convention only.
    "object_naming": {
      "patternKind": "required",
      "severity": "Error",
      "clas": "^(?=.{1,25}$)Z2UI5_C(L|X)_SMPS_",
      "tabl": "^(?=.{1,16}$)Z2UI5_(T|D)_SMPS_"
    },
    // enforces the per object type name length limits of the ABAP repository
    "allowed_object_naming": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    // see the note at "superclass_final" below
    "check_syntax": {
      "exclude": ["z2ui5_cl_smps_app_489(_ws)?\\.clas\\."]
    },
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    // z2ui5_cl_smps_app_489_ws inherits from cl_apc_wsp_ext_stateless_base.
    // ABAP Push Channels are on-premise only and therefore absent from
    // steampunk-2305-api, the single API dependency of this repository, so
    // the superclass cannot be resolved. The class pool then fails to
    // activate for abaplint, which is why app_489 - the app driving the
    // channel - reports its references to it as unknown as well.
    "superclass_final": {
      "exclude": ["z2ui5_cl_smps_app_489_ws\\.clas\\."]
    },
    "unknown_types": true,
    "xml_consistency": true,

    // --- raised to the level abap2UI5/samples-controls holds itself to ---
    // This repository ships code meant to be copied, and it was checked by 17
    // rules where the control corpus is checked by 45. The gap was visible in
    // the corpus: commented-out lines shipped in two samples, three public
    // attributes nobody read. Both are below, both are now errors.
    "commented_code": true,
    "unused_variables": {
      // same pools, same reason as unused_methods below: a handler's IMPORTING
      // parameters are fixed by its signature, and abaplint has no grammar for
      // RAISE ENTITY EVENT - so a variable the event consumes reads as unused
      "exclude": ["z2ui5_cl_smps_bp_[a-z]+\\.clas\\.locals_imp\\."]
    },
    "unused_types": true,
    "unreachable_code": true,
    "empty_statement": true,
    "ambiguous_statement": true,
    "identical_conditions": true,
    "identical_contents": true,
    "when_others_last": true,
    "constructor_visibility_public": true,
    "no_chained_assignment": true,
    "names_no_dash": true,
    "functional_writing": true,
    "preferred_compare_operator": true,
    "use_line_exists": true,
    "prefer_is_not": true,
    "obsolete_statement": true,
    "colon_missing_space": true,
    "contains_tab": true,
    // the ABAP editor strips a trailing blank when it saves, so a line that
    // ends in one comes back changed on the next pull - for everyone
    "whitespace_end": true,
    "7bit_ascii": true,
    "sequential_blank": {
      "lines": 3
    },
    // NOT enabled here, unlike in samples-controls, and both for the same
    // reason - this repository has RAP and that one does not:
    //   keyword_case      CDS entities, actions and fields are CamelCase by
    //                     definition (Ticket, TravelUuid, Activate), and the
    //                     rule reads every one of them as a lower-case
    //                     violation. 31 findings, all of them correct ABAP.
    //   max_one_statement the operator mapping in app 319 is a table written
    //                     as a CASE, one WHEN per line. Splitting it costs
    //                     the shape that makes it readable.
    "unused_methods": {
      // a RAP behavior implementation is called by the runtime, never from
      // ABAP - every handler method in a bp_ pool reads as unused
      "exclude": ["z2ui5_cl_smps_bp_[a-z]+\\.clas\\.locals_imp\\."]
    },
    "types_naming": {
      // ty_s_ for a structure, t_ for its table - the scheme this repository
      // uses, which is not samples-controls' ty_t_
      "pattern": "^(TY_|T_)"
    }
  }
}
