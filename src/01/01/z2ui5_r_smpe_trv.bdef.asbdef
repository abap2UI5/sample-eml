// Managed business object without draft. Everything the abap2UI5 apps
// z2ui5_cl_smpe_app_01 and z2ui5_cl_smpe_app_05 call with EML is declared here -
// the runtime executes the validations, the determination and the feature
// control no matter who triggers the operation.
managed implementation in class z2ui5_cl_smpe_bp_trv unique;
strict ( 2 );

define behavior for z2ui5_r_smpe_trv alias Travel
persistent table z2ui5_t_smpe_trv
lock master
authorization master ( global )
etag master LastChangedAt
// the key is a readable number, not a UUID, so it cannot be drawn by the
// managed runtime - earlynumbering_create in the behavior pool assigns it
early numbering
{
  create;
  update;
  delete;

  // never typed by the caller: early numbering assigns it, which is why the
  // new key comes back in MAPPED
  field ( readonly ) TravelId;

  // set by the determination and by the actions, never by the caller
  field ( readonly ) OverallStatus, TotalPrice;

  // filled by the managed runtime from the @Semantics annotations of the CDS
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;

  field ( mandatory ) AgencyId, CustomerId, BeginDate, EndDate;

  determination setInitialValues on modify { create; }

  validation validateCustomer on save { create; field CustomerId; }
  validation validateDates    on save { create; update; field BeginDate, EndDate; }

  action acceptTravel result [1] $self;
  action rejectTravel result [1] $self;

  mapping for z2ui5_t_smpe_trv
    {
      TravelId      = travel_id;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      BookingFee    = booking_fee;
      TotalPrice    = total_price;
      CurrencyCode  = currency_code;
      Description   = description;
      OverallStatus = overall_status;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}