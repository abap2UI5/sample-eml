managed with additional save implementation in class z2ui5_cl_smpe_bp_tck unique;
strict ( 2 );
with draft;

define behavior for Z2UI5_R_SMPE_TCK alias Ticket
persistent table z2ui5_t_smpe_tck
draft table z2ui5_d_smpe_tck
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed ) TicketUUID;
  field ( mandatory ) Title;
  field ( readonly ) CreatedBy, CreatedAt, ChangedBy, LastChangedAt, LocalLastChangedAt;

  // ---- Business Events ----
  // Notification event (key only) - fired on CREATE
  event TicketCreated;
  // Data event (enriched payload) - fired on UPDATE
  event StatusChanged parameter Z2UI5_R_SMPE_TCK_STAT;

  // ---- Draft actions (mandatory with 'with draft' + 'strict') ----
  draft action Resume;
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft determine action Prepare;

  determination manageAdmin on modify { create; field Title, Priority, Status; }

  mapping for z2ui5_t_smpe_tck
  {
    TicketUUID    = ticket_uuid;
    Title         = title;
    Priority      = priority;
    Status        = status;
    CreatedBy     = created_by;
    CreatedAt     = created_at;
    ChangedBy     = changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}