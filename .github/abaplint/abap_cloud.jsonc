{
  // Cloud syntax check: EML is available in the ABAP Cloud language version
  // as well, so the sample is validated against it in addition to the
  // on-premise release in the root abaplint.jsonc. There is no cloud branch -
  // unlike the samples repository this one ships a single set of sources.
  //   npx abaplint .github/abaplint/abap_cloud.jsonc
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    // see the root abaplint.jsonc - the RAP business objects of the flight
    // reference scenario are not part of the dependencies
    "errorNamespace": "^Z2UI5"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
